{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react"
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/lib/**/__tests__/**/*.ts",
    "src/lib/**/__tests__/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
