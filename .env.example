# DFS Edge Pro — Environment Variables
# Copy this file to .env and fill in REAL values.
# .env is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase Authentication
# ---------------------------------------------------------------------------
# Create a free project at https://supabase.com
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT secret that Supabase embeds in tokens — used by FastAPI to verify
# Supabase-issued JWTs.  Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ---------------------------------------------------------------------------
# JWT Authentication (FastAPI — legacy, until full Supabase migration)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be a strong random value — never commit the real key.
JWT_SECRET_KEY=replace_with_64_char_hex_generated_by_secrets_token_hex_32

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ---------------------------------------------------------------------------
# Development:  http://localhost:3000,http://localhost:5173
# Production:   https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# External API Keys
# ---------------------------------------------------------------------------
# TheOdds API — https://the-odds-api.com/  (free tier: 500 req/month)
THEODDS_API_KEY=your_theodds_api_key_here

# OpenWeather API — https://openweathermap.org/api  (free tier: 1000 req/day)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# SportsData.io — https://sportsdata.io/  (injury data + slate enrichment)
SPORTSDATA_API_KEY=your_sportsdata_api_key_here

# BallDontLie API — https://www.balldontlie.io/
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here

# ---------------------------------------------------------------------------
# Injury Enrichment Settings
# ---------------------------------------------------------------------------
INJURY_DATA_REQUIRED=false
# "open"   — warn and continue when injury fetch fails (development)
# "closed" — return HTTP 503 when injury fetch fails (production)
INJURY_DATA_FAIL_MODE=open

# ---------------------------------------------------------------------------
# Auth bypass — development only
# ---------------------------------------------------------------------------
# Set to "1" to skip JWT verification on all routes (never enable in prod).
# Tests that require auth to be active must monkeypatch this to "0".
DFS_DISABLE_AUTH=0

# ---------------------------------------------------------------------------
# Database — optional Postgres for user auth (backend/database/db.py)
# ---------------------------------------------------------------------------
# Leave blank to run in DB-less mode (JWT claims only, no user persistence)
# postgres://user:password@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# Projection Cache (DuckDB)
# ---------------------------------------------------------------------------
# How long projection cache entries are valid (seconds). Default: 21600 (6h)
PROJECTION_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Scheduler settings (workers/schedulers/daily.py)
# ---------------------------------------------------------------------------
# Timezone for scheduled jobs (IANA tz string)
SCHEDULER_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Optimizer defaults
# ---------------------------------------------------------------------------
# Maximum player exposure across generated lineups (0–1)
DEFAULT_MAX_EXPOSURE=0.60
# Default site when none is specified
DEFAULT_DFS_SITE=FD
# Default sport
DEFAULT_SPORT=NBA

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=info
# Path for rotating file log (leave blank to log to stdout only)
LOG_FILE=logs/backend/app.log

# ---------------------------------------------------------------------------
# Contest import
# ---------------------------------------------------------------------------
# Directory scanned by the nightly import_contests job
CONTEST_RESULTS_DIR=data/contest_results

# ---------------------------------------------------------------------------
# Stripe Billing (backend/routers/billing.py)
# ---------------------------------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_replace_me
# Dashboard → Products → find your Pro price → copy price ID
STRIPE_PRICE_ID_PRO=price_replace_me
# Dashboard → Webhooks → Add endpoint → reveal signing secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Base URL of your frontend (used for Checkout success/cancel redirects)
FRONTEND_URL=http://localhost:3000
